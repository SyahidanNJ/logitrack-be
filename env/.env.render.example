# Contoh env vars untuk Render Web Service (logitrack-be).
# Salin tiap baris ke dashboard Render → Environment.
# JANGAN isi secret asli di file ini — file ini ikut ke-push ke GitHub.
# File env asli (env/.env.dev, env/.env.prod) tetap di-ignore oleh .gitignore.

SERVICE_NAME=logitrack
NODE_ENV=production
PORT=3003
JWT_SECRET=ISI_DENGAN_STRING_ACAK_32_KARAKTER_ATAU_LEBIH

# FE production (diisi setelah Static Site FE jadi, tanpa trailing slash)
ALLOWED_ORIGINS=https://logitrack-fe-xxxx.onrender.com

# Wajib true untuk TiDB Cloud (TLS). Lokal/MySQL biasa: false atau kosong.
MYSQL_SSL=true

# --- Database utama (cluster logitrackdb → database db_logitrack) ---
MYSQL_LOGITRACK_HOST=xxx.tidbcloud.com
MYSQL_LOGITRACK_PORT=4000
MYSQL_LOGITRACK_NAME=db_logitrack
MYSQL_LOGITRACK_USER=root
MYSQL_LOGITRACK_PASS=ISI_PASSWORD_TIDB
MYSQL_LOGITRACK_DIALECT=mysql
MYSQL_LOGITRACK_POOL_MIN=0
MYSQL_LOGITRACK_POOL_MAX=5
MYSQL_LOGITRACK_POOL_IDLE=10000
MYSQL_LOGITRACK_POOL_ACQUIRE=60000
MYSQL_LOGITRACK_POOL_EVICT=10000
MYSQL_LOGITRACK_LOGGING=false

# --- Database HR (cluster yang sama → database db_employee) ---
MYSQL_EMPLOYEE_HOST=xxx.tidbcloud.com
MYSQL_EMPLOYEE_PORT=4000
MYSQL_EMPLOYEE_NAME=db_employee
MYSQL_EMPLOYEE_USER=root
MYSQL_EMPLOYEE_PASS=ISI_PASSWORD_TIDB
MYSQL_EMPLOYEE_DIALECT=mysql
MYSQL_EMPLOYEE_POOL_MIN=0
MYSQL_EMPLOYEE_POOL_MAX=5
MYSQL_EMPLOYEE_POOL_IDLE=10000
MYSQL_EMPLOYEE_POOL_ACQUIRE=60000
MYSQL_EMPLOYEE_POOL_EVICT=10000
MYSQL_EMPLOYEE_LOGGING=false

# --- Email (opsional, alert scheduler; kosongkan bila belum dipakai) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
